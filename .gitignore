# Built outputs
.gradle/
build/
app/build/

# IDE
.idea/
*.iml

# Local config
local.properties

# Signing (release keystore + passwords — never commit)
*.jks
*.keystore
keystore.properties
# Shared debug key: public, non-secret, committed on purpose so CI debug APKs keep a stable
# signature and can update an existing install (the default ~/.android/debug.keystore is
# regenerated on every ephemeral CI runner, so its signature changes between builds).
!app/debug.keystore

# Debug / profiling
*.hprof

# Claude
.claude/
/.kotlin/
/.agents/
/.aicode/

# 临时调试文件
/*.log
log-*.txt
*.apk
/test

# Python（模型数据更新脚本）
__pycache__/
*.pyc